// The test genomes are a few dozen kilobases: finer sketches, and matches of
// a kilobase. And NCBI is never reached: its API is a port nothing listens on,
// as on a node without network.
process {
    withName: 'SOURMASH_SKETCH|SKETCH_DATABASE' {
        ext.args = "dna --param-string 'scaled=100,k=21,k=31,k=51,noabund'"
    }
    withName: 'SOURMASH_GATHER' {
        ext.args = '--ksize 31 --create-empty-results --threshold-bp 1000'
    }
    withName: 'PLEXEMBLER_CLOSEST' {
        ext.args = '--api http://127.0.0.1:9/datasets/v2 --attempts 1'
    }
}
