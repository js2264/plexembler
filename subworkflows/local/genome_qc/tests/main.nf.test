nextflow_workflow {

    name "Test subworkflow GENOME_QC"
    script "../main.nf"
    workflow "GENOME_QC"

    tag "subworkflows"
    tag "subworkflows_local"
    tag "genome_qc"

    test("a pool with WGS and one without - stub") {

        options "-stub"

        when {
            workflow {
                """
                def meryl = file("\${launchDir}/k.meryl")
                meryl.mkdirs()
                input[0] = channel.of(
                    [
                        [ id: 'sp1', pool: 'poolA', candidate: 'flye', busco_lineage: null ],
                        file('${moduleDir}/../../../tests/data/truth/sp1.fa', checkIfExists: true),
                    ],
                    [
                        [ id: 'sp2', pool: 'poolB', candidate: 'flye', busco_lineage: 'eukaryota_odb12' ],
                        file('${moduleDir}/../../../tests/data/truth/sp2.fa', checkIfExists: true),
                    ],
                )
                input[1] = channel.of([ [ id: 'sp1' ], meryl ], [ [ id: 'sp2' ], meryl ])
                input[2] = channel.of([ [ id: 'poolA' ], meryl ])
                input[3] = 'eukaryota_odb12'
                input[4] = []
                """
            }
        }

        then {
            def qv = workflow.out.qv.collectEntries { meta, _qv, kmers -> [meta.id, kmers] }
            assertAll(
                { assert workflow.success },
                { assert workflow.out.stats.size() == 2 },
                // BUSCO's stub writes no short summary: CONTIGS writes NA for it.
                { assert workflow.out.busco.size() == 0 },
                // poolA has WGS k-mers to count the QV against; poolB has not.
                { assert qv == [sp1: 'wgs', sp2: 'ont'] },
                { assert workflow.out.completeness.size() == 2 },
            )
        }
    }
}
