nextflow_workflow {

    name "Test subworkflow EXPRESSION"
    script "../main.nf"
    workflow "EXPRESSION"

    tag "subworkflows"
    tag "subworkflows_local"
    tag "expression"

    test("a species' library - stub") {

        options "-stub"

        when {
            workflow {
                """
                // A file per input, each under its own name: Nextflow 26.04.0
                // refuses to stage two files under one name in a task.
                def fasta = file('${moduleDir}/../../../tests/data/truth/sp1.fa', checkIfExists: true)
                def bam = file('${moduleDir}/main.nf', checkIfExists: true)
                def bai = file('${moduleDir}/meta.yml', checkIfExists: true)
                input[0] = channel.of([ [ id: 'sp1', pool: 'pool', library: 'rna-ypd-1', condition: 'YPD', replicate: 1 ], bam, bai ])
                input[1] = channel.of([ [ id: 'sp1' ], fasta ])
                input[2] = channel.of([ [ id: 'sp1' ], fasta ])
                input[3] = channel.of([ [ id: 'sp1' ], file('${moduleDir}/../../../tests/data/sp1.ont.fastq.gz', checkIfExists: true) ])
                input[4] = 'reverse'
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.out.tpm.size() == 1 },
                { assert workflow.out.rnaseq_tracks.size() == 2 },
                { assert workflow.out.ont_tracks.size() == 1 },
            )
        }
    }
}
