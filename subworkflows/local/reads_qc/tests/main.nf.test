nextflow_workflow {

    name "Test subworkflow READS_QC"
    script "../main.nf"
    workflow "READS_QC"

    tag "subworkflows"
    tag "subworkflows_local"
    tag "reads_qc"

    test("a species and a pooled library") {

        when {
            workflow {
                """
                input[0] = channel.of([
                    [ id: 'sp1', pool: 'pool' ],
                    [ file('${moduleDir}/../../../tests/data/sp1.ont.fastq.gz', checkIfExists: true) ],
                ])
                input[1] = channel.of([
                    [ id: 'wgs', pool: 'pool', type: 'wgs', single_end: false ],
                    [
                        file('${moduleDir}/../../../tests/data/pool_wgs_R1.fastq.gz', checkIfExists: true),
                        file('${moduleDir}/../../../tests/data/pool_wgs_R2.fastq.gz', checkIfExists: true),
                    ],
                ])
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.out.nanoplot.size() == 1 },
                { assert workflow.out.fastqc_zip.size() == 1 },
                // NanoPlot's statistics and FastQC's two archives.
                { assert workflow.out.multiqc_files.size() == 3 },
            )
        }
    }

    test("a species and a pooled library - stub") {

        options "-stub"

        when {
            workflow {
                """
                input[0] = channel.of([
                    [ id: 'sp1', pool: 'pool' ],
                    [ file('${moduleDir}/../../../tests/data/sp1.ont.fastq.gz', checkIfExists: true) ],
                ])
                input[1] = channel.of([
                    [ id: 'wgs', pool: 'pool', type: 'wgs', single_end: false ],
                    [
                        file('${moduleDir}/../../../tests/data/pool_wgs_R1.fastq.gz', checkIfExists: true),
                        file('${moduleDir}/../../../tests/data/pool_wgs_R2.fastq.gz', checkIfExists: true),
                    ],
                ])
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.out.nanoplot.size() == 1 },
                { assert workflow.out.fastqc_zip.size() == 1 },
            )
        }
    }
}
