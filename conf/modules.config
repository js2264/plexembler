/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    // The results of a species go under species/<species>/, those of a pool
    // under pools/<pool>/ (docs/output.md).

    //
    // A species' nanopore reads (ONT_READS)
    //
    withName: 'SAMTOOLS_FASTQ' {
        // Dorado's tags kept in the reads' headers: its model, which Medaka can read.
        ext.args   = '-T "*"'
        publishDir = [ enabled: false ]
    }

    withName: 'CAT_FASTQ' {
        publishDir = [ enabled: false ]
    }

    withName: 'NANOPLOT' {
        ext.args   = { "--prefix ${meta.id}_" }
        publishDir = [
            path: { "${params.outdir}/species/${meta.id}/qc/nanoplot" },
            mode: params.publish_dir_mode,
        ]
    }

    withName: 'CHOPPER' {
        // The mean quality by chemistry: R9 reads are about Q12, R10 reads Q18 and above.
        ext.args2  = { "--minlength ${params.ont_min_length} --quality ${params.ont_min_quality != null ? params.ont_min_quality : (meta.chemistry == 'r9' ? 7 : 10)}" }
        publishDir = [ enabled: false ]
    }

    withName: 'LRGE' {
        // A seed: the same reads give the same estimate.
        ext.args   = '--seed 42'
        publishDir = [
            path: { "${params.outdir}/species/${meta.id}/estimates" },
            mode: params.publish_dir_mode,
        ]
    }

    withName: 'FILTLONG' {
        ext.args   = { "--target_bases ${meta.target_bases}" }
        publishDir = [
            [
                path: { "${params.outdir}/species/${meta.id}/qc/filtlong" },
                mode: params.publish_dir_mode,
                pattern: '*.log',
            ],
            [
                path: { "${params.outdir}/species/${meta.id}/reads" },
                mode: params.publish_dir_mode,
                pattern: '*.fastq.gz',
                saveAs: { _filename -> "${meta.id}.ont.fastq.gz" },
                enabled: params.save_ont_reads,
            ],
        ]
    }

    //
    // The k-mers (KMERS)
    //
    withName: 'MERYL_.*' {
        publishDir = [ enabled: false ]
    }

    withName: 'MERYL_COUNT_ONT|MERYL_HISTOGRAM' {
        ext.prefix = { "${meta.id}.ont" }
    }

    withName: 'MERYL_COUNT_WGS|MERYL_UNIONSUM' {
        ext.prefix = { "${meta.id}.wgs" }
    }

    withName: 'GENOMESCOPE2' {
        // The species' nanopore k-mers fitted as a diploid's: a heterozygosity
        // near 0 says haploid or homozygous. A spectrum it cannot fit leaves the
        // species without an estimate, not the run without its results.
        ext.args      = { "--ploidy 2 --kmer_length ${params.kmer_size}" }
        errorStrategy = 'ignore'
        publishDir    = [
            path: { "${params.outdir}/species/${meta.id}/estimates/genomescope2" },
            mode: params.publish_dir_mode,
        ]
    }

    //
    // A species' contigs: candidates, polished, checked, one kept (CONTIGS)
    //
    withName: 'FLYE' {
        // A haploid or homozygous species (docs/plan.md): no other haplotype's contigs.
        ext.args   = { (meta.ploidy ?: 1) == 1 ? '--no-alt-contigs' : '' }
        ext.prefix = { "${meta.id}.flye" }
        publishDir = [
            path: { "${params.outdir}/species/${meta.id}/candidates/assembly/flye" },
            mode: params.publish_dir_mode,
            pattern: '*.{gfa.gz,txt,log,json}',
        ]
    }

    withName: 'HIFIASM' {
        // Nanopore reads; and, for a haploid or homozygous species, no purging.
        ext.args   = { (meta.ploidy ?: 1) == 1 ? '--ont -l0' : '--ont' }
        ext.prefix = { "${meta.id}.hifiasm" }
        publishDir = [
            path: { "${params.outdir}/species/${meta.id}/candidates/assembly/hifiasm" },
            mode: params.publish_dir_mode,
            pattern: '*.{p_ctg.gfa,stderr.log}',
        ]
    }

    withName: 'GFATOOLS_GFA2FA' {
        ext.prefix = { "${meta.id}.hifiasm" }
        publishDir = [ enabled: false ]
    }

    withName: 'PLEXEMBLER_RENAME' {
        ext.prefix = { "${meta.id}.${meta.candidate}.contigs" }
        publishDir = [
            path: { "${params.outdir}/species/${meta.id}/candidates/assembly/${meta.candidate}" },
            mode: params.publish_dir_mode,
        ]
    }

    withName: 'MEDAKA' {
        ext.args   = { "-m ${params.medaka_model ?: (meta.chemistry == 'r9' ? 'r941_min_sup_g507' : 'r1041_e82_400bps_sup_v5.2.0')}" }
        ext.prefix = { "${meta.id}.${meta.candidate}.polished" }
        publishDir = [
            path: { "${params.outdir}/species/${meta.id}/candidates/assembly/${meta.candidate}" },
            mode: params.publish_dir_mode,
        ]
    }

    withName: 'DORADO_POLISH' {
        ext.prefix = { "${meta.id}.${meta.candidate}.polished" }
        publishDir = [
            path: { "${params.outdir}/species/${meta.id}/candidates/assembly/${meta.candidate}" },
            mode: params.publish_dir_mode,
        ]
    }

    //
    // A sequence's checks (GENOME_QC), under its stage and candidate
    //
    withName: 'GFASTATS' {
        ext.args   = '--tabular'
        ext.prefix = { "${meta.id}.${meta.candidate}" }
        publishDir = [
            path: { meta.candidate == 'genome' ? "${params.outdir}/species/${meta.id}/genome/qc/gfastats" : "${params.outdir}/species/${meta.id}/candidates/assembly/${meta.candidate}/qc/gfastats" },
            mode: params.publish_dir_mode,
        ]
    }

    withName: 'BUSCO_BUSCO' {
        // Lineages downloaded beforehand (--busco_db): no network needed.
        ext.args   = { params.busco_db ? '--offline' : '' }
        ext.prefix = { "${meta.id}.${meta.candidate}" }
        publishDir = [
            path: { meta.candidate == 'genome' ? "${params.outdir}/species/${meta.id}/genome/qc/busco" : "${params.outdir}/species/${meta.id}/candidates/assembly/${meta.candidate}/qc/busco" },
            mode: params.publish_dir_mode,
            pattern: '{short_summary.*,*-busco.batch_summary.txt,*-busco.log}',
        ]
    }

    withName: 'MERQURY_QV|MERQURY_COMPLETENESS' {
        ext.prefix = { "${meta.id}.${meta.candidate}.${meta.qv_kmers}" }
        publishDir = [
            path: { meta.candidate == 'genome' ? "${params.outdir}/species/${meta.id}/genome/qc/merqury" : "${params.outdir}/species/${meta.id}/candidates/assembly/${meta.candidate}/qc/merqury" },
            mode: params.publish_dir_mode,
            pattern: '*.{qv,completeness.stats,png,hist}',
        ]
    }

    withName: 'PLEXEMBLER_SELECT' {
        publishDir = [
            path: { "${params.outdir}/species/${meta.id}/assembly" },
            mode: params.publish_dir_mode,
        ]
    }

    //
    // A pool's libraries split between its species (POOL_DECONVOLVE)
    //
    withName: 'CAT_REFERENCE' {
        ext.prefix = { "${meta.id}.fa.gz" }
        publishDir = [ enabled: false ]
    }

    withName: 'BWAMEM2_INDEX|BWA_INDEX|CAT_FASTQ_POLISH' {
        publishDir = [ enabled: false ]
    }

    withName: 'BWAMEM2_MEM' {
        // Hi-C: each mate on its own, its 5' alignment primary (-5SP).
        ext.args   = { meta.type == 'hic' ? '-5SP' : '' }
        ext.prefix = { "${meta.pool}.${meta.id}.${meta.stage}" }
        publishDir = [ enabled: false ]
    }

    withName: 'PLEXEMBLER_SPLIT' {
        ext.args   = { "--min-mapq ${params.deconvolve_mapq} --min-identity ${params.deconvolve_min_identity} --holdout ${params.polish_holdout}" }
        publishDir = [
            [
                path: { "${params.outdir}/pools/${meta.pool}/deconvolution/${meta.stage}" },
                mode: params.publish_dir_mode,
                pattern: '*.{tsv,json,log}',
            ],
            [
                path: { "${params.outdir}/pools/${meta.pool}/deconvolution/${meta.stage}/reads" },
                mode: params.publish_dir_mode,
                pattern: '*.fastq.gz',
                enabled: params.save_split_reads,
            ],
        ]
    }

    //
    // Each species polished with its short reads (POLISH_SR)
    //
    withName: 'PLEXEMBLER_DIGEST' {
        publishDir = [
            path: { "${params.outdir}/species/${meta.id}/polish" },
            mode: params.publish_dir_mode,
            pattern: '*.{json,tsv,log}',
        ]
    }

    withName: 'BWA_MEM' {
        // Every alignment of each read, as Polypolish needs; SAM, read by read.
        ext.args   = '-a'
        ext.args2  = '--output-fmt sam'
        ext.prefix = { "${meta.id}.${meta.read}" }
        publishDir = [ enabled: false ]
    }

    withName: 'CAT_DRAFT_PLAIN' {
        ext.prefix = { "${meta.id}.draft.fa" }
        publishDir = [ enabled: false ]
    }

    withName: 'POLYPOLISH_POLISH' {
        ext.prefix = { "${meta.id}.polypolish" }
        publishDir = [
            path: { "${params.outdir}/species/${meta.id}/candidates/polish" },
            mode: params.publish_dir_mode,
        ]
    }

    withName: 'PYPOLCA' {
        // Changes only with strong support: Hi-C's coverage is uneven.
        ext.args   = '--careful'
        ext.prefix = { "${meta.id}.pypolca" }
        publishDir = [
            path: { "${params.outdir}/species/${meta.id}/candidates/polish" },
            mode: params.publish_dir_mode,
        ]
    }

    withName: 'MERYL_COUNT_HOLDOUT|MERYL_UNIONSUM_HOLDOUT' {
        ext.prefix = { "${meta.id}.holdout" }
    }

    withName: 'MERQURY_POLISH' {
        ext.prefix = { "${meta.id}.${meta.candidate}.holdout" }
        publishDir = [
            path: { "${params.outdir}/species/${meta.id}/candidates/polish/qc/merqury" },
            mode: params.publish_dir_mode,
            pattern: '*.{qv,completeness.stats}',
        ]
    }

    withName: 'SELECT_POLISH' {
        // A polishing kept when it raises the held-out QV by more than 0.1:
        // their pairs' sampling holds that QV far below the genome's, so that
        // a polishing that fixes 4 errors in 10 raises it by 1 (docs/plan.md, M2).
        ext.args   = '--qv-tolerance 0.1'
        publishDir = [
            path: { "${params.outdir}/species/${meta.id}/polish" },
            mode: params.publish_dir_mode,
        ]
    }

    //
    // The contig screen (SCREEN)
    //
    withName: 'CAT_POOL' {
        ext.prefix = { "${meta.id}.polished.fa.gz" }
        publishDir = [ enabled: false ]
    }

    withName: 'CAT_POOL_TARGET' {
        ext.prefix = { "${meta.id}.target.fa.gz" }
        publishDir = [ enabled: false ]
    }

    withName: 'MINIMAP2_READS' {
        ext.args   = '-x map-ont --secondary=no'
        ext.prefix = { "${meta.id}.on_${meta.pool}" }
        publishDir = [ enabled: false ]
    }

    withName: 'MINIMAP2_IDENTITY' {
        // The pool's contigs on each other, without self-alignments.
        ext.args   = '-x asm10 -X'
        ext.prefix = { "${meta.id}.self" }
        publishDir = [ enabled: false ]
    }

    withName: 'PLEXEMBLER_SCREEN' {
        publishDir = [
            [
                path: { "${params.outdir}/pools/${meta.id}/screen" },
                mode: params.publish_dir_mode,
                pattern: '*.{tsv,log}',
            ],
            [
                path: { "${params.outdir}/species" },
                mode: params.publish_dir_mode,
                pattern: '*.screened.fa.gz',
                saveAs: { filename -> "${filename.tokenize('.')[0]}/contigs/${filename.replace('.screened.', '.contigs.')}" },
            ],
        ]
    }

    //
    // Each species scaffolded and finished (SCAFFOLD)
    //
    withName: 'CAT_FASTQ_HIC|BWAMEM2_INDEX_SPECIES|BWAMEM2_INDEX_GENOME|SAMTOOLS_FAIDX_CONTIGS' {
        publishDir = [ enabled: false ]
    }

    withName: 'PAIRTOOLS_SORT' {
        // Not the name of the deduplicated pairs, which are published.
        ext.prefix = { "${meta.id}.sorted" }
        publishDir = [ enabled: false ]
    }

    withName: 'BWAMEM2_MEM_SPECIES|BWAMEM2_MEM_GENOME' {
        // Hi-C: each mate on its own, its 5' alignment primary.
        ext.args   = '-5SP'
        ext.prefix = { "${meta.id}.hic" }
        publishDir = [ enabled: false ]
    }

    withName: 'YAHS|YAHS_RESCAFFOLD' {
        // The library's restriction motifs, from its enzymes; none for Micro-C.
        // And its resolutions, given: YaHS's own choice, from the contigs' N50,
        // makes no join below an N50 of 100 kb, which a yeast's contigs from
        // short nanopore reads can be (the benchmark's second set). The first
        // pass from 1 kb, at which a contig of 10 to 20 kb has the bins to be
        // oriented; the second (YAHS_RESCAFFOLD, given the first's AGP) from
        // 5 kb, which on the benchmark joined what the first left apart and
        // placed no small contig anew, as it did from 1 kb.
        ext.args   = {
            def motifs = (meta.enzymes ?: '').tokenize(',').collect { enzyme -> ['DpnII': 'GATC', 'MboI': 'GATC', 'Sau3AI': 'GATC', 'HinfI': 'GANTC', 'DdeI': 'CTNAG', 'MseI': 'TTAA', 'Csp6I': 'GTAC', 'HindIII': 'AAGCTT', 'BglII': 'AGATCT', 'EcoRI': 'GAATTC', 'NlaIII': 'CATG', 'arima': 'GATC,GANTC'][enzyme.trim()] }.findAll { motif -> motif }.unique()
            def resolutions = [1000, 2000, 5000, 10000, 20000, 50000, 100000, 200000, 500000, 1000000, 2000000, 5000000, 10000000, 20000000, 50000000, 100000000]
                .findAll { resolution -> resolution >= (agp ? 5000 : 1000) }
            [motifs ? "-e ${motifs.join(',')}" : '', "-r ${resolutions.join(',')}"].findAll { arg -> arg }.join(' ')
        }
        ext.prefix = { agp ? "${meta.id}.yahs_rescaffold" : "${meta.id}.yahs" }
        publishDir = [
            path: { "${params.outdir}/species/${meta.id}/candidates/scaffold/yahs" },
            mode: params.publish_dir_mode,
            pattern: '*{_scaffolds_final.fa,_scaffolds_final.agp,.log}',
        ]
    }

    withName: 'PLEXEMBLER_FINALIZE' {
        ext.args   = { "--min-chromosome ${params.min_chromosome}" }
        publishDir = [
            path: { "${params.outdir}/species/${meta.id}/genome" },
            mode: params.publish_dir_mode,
        ]
    }

    //
    // Each species' Hi-C map (MAPS)
    //
    withName: 'PAIRTOOLS_PARSE' {
        ext.args   = '--min-mapq 30 --walks-policy 5unique --max-inter-align-gap 30 --drop-sam --drop-seq'
        publishDir = [
            path: { "${params.outdir}/species/${meta.id}/hic" },
            mode: params.publish_dir_mode,
            pattern: '*.stat',
        ]
    }

    withName: 'PAIRTOOLS_DEDUP' {
        ext.prefix = { "${meta.id}" }
        publishDir = [
            path: { "${params.outdir}/species/${meta.id}/hic" },
            mode: params.publish_dir_mode,
        ]
    }

    withName: 'COOLER_CLOAD' {
        // 4DN pairs: chromosome and position of each mate.
        ext.args   = '-c1 2 -p1 3 -c2 4 -p2 5'
        publishDir = [ enabled: false ]
    }

    withName: 'PLEXEMBLER_JUNCTIONS' {
        publishDir = [
            path: { "${params.outdir}/species/${meta.id}/genome/qc/junctions" },
            mode: params.publish_dir_mode,
        ]
    }

    withName: 'COOLER_ZOOMIFY' {
        ext.args   = '--balance'
        publishDir = [
            path: { "${params.outdir}/species/${meta.id}/hic" },
            mode: params.publish_dir_mode,
        ]
    }

    //
    // A pool's species (CONTIGS)
    //
    withName: 'SKANI_TRIANGLE|PLEXEMBLER_ANI' {
        publishDir = [
            path: { "${params.outdir}/pools/${meta.id}/ani" },
            mode: params.publish_dir_mode,
        ]
    }

    withName: 'FASTQC' {
        ext.args   = '--quiet'
        publishDir = [
            path: { "${params.outdir}/pools/${meta.pool}/qc/fastqc" },
            mode: params.publish_dir_mode,
        ]
    }

    //
    // Each pooled RNA-seq library split between its species (RNASEQ)
    //
    withName: 'CAT_GENOMES' {
        // Plain: STAR reads no gzip.
        ext.prefix = { "${meta.id}.fa" }
        publishDir = [ enabled: false ]
    }

    withName: 'STAR_GENOMEGENERATE|CAT_FASTQ_RNASEQ|CAT_GENOME_PLAIN|SAMTOOLS_MERGE_RNASEQ' {
        publishDir = [ enabled: false ]
    }

    withName: 'CAT_GENOME_PLAIN' {
        ext.prefix = { "${meta.id}.fa" }
    }

    withName: 'SAMTOOLS_MERGE_RNASEQ' {
        ext.prefix = { "${meta.id}.rnaseq" }
    }

    withName: 'STAR_ALIGN' {
        // Unsorted, a read's records together, for the split; each mate's
        // edit distance (NM) for its identity; introns capped at 5 kb: compact
        // genomes get false splices otherwise.
        ext.args   = '--outSAMtype BAM Unsorted --outSAMattributes NH HI AS nM NM --outSAMunmapped Within --outFilterMultimapNmax 20 --alignIntronMax 5000 --alignMatesGapMax 5000 --outSAMstrandField intronMotif'
        publishDir = [
            path: { "${params.outdir}/pools/${meta.pool}/deconvolution/rnaseq/star" },
            mode: params.publish_dir_mode,
            pattern: '*Log.final.out',
        ]
    }

    withName: 'PLEXEMBLER_SPLIT_RNASEQ' {
        ext.args   = { "--min-mapq ${params.deconvolve_mapq} --min-identity ${params.deconvolve_min_identity}" }
        publishDir = [
            path: { "${params.outdir}" },
            mode: params.publish_dir_mode,
            // Each species' alignments in its folder; the tables in the pool's.
            saveAs: { filename ->
                filename.endsWith('.bam') || filename.endsWith('.bai') ? "species/${filename.tokenize('.')[0]}/rnaseq/${filename}"
                    : filename.endsWith('.fastq.gz') ? null
                    : "pools/${meta.pool}/deconvolution/rnaseq/${filename}"
            },
        ]
    }

    //
    // Each species' annotation (ANNOTATION)
    //
    withName: 'REPEATMODELER_BUILDDATABASE' {
        publishDir = [ enabled: false ]
    }

    withName: 'REPEATMODELER_REPEATMODELER' {
        // Not <species>.fa, the name RepeatMasker unzips the genome to.
        ext.prefix = { "${meta.id}.families" }
        publishDir = [
            path: { "${params.outdir}/species/${meta.id}/annotation/repeats" },
            mode: params.publish_dir_mode,
            pattern: '*.{fa,log}',
        ]
    }

    withName: 'REPEATMASKER_REPEATMASKER' {
        ext.args   = '-xsmall -gff'
        publishDir = [
            path: { "${params.outdir}/species/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                filename.endsWith('.masked') ? "genome/${meta.id}.softmasked.fa" : "annotation/repeats/${filename}"
            },
        ]
    }

    withName: 'BRAKER3' {
        // AUGUSTUS's model of --augustus_species, the evidence as hints, without
        // training: a yeast's genome holds too few genes and introns to train on
        // (the benchmark's second set: GeneMark-ET failed on S. cerevisiae's 14
        // introns, and the models it trained found fewer genes than S.
        // cerevisiae's own). --braker_train trains on the species instead.
        ext.args   = {
            params.braker_train || !params.augustus_species
                ? '--fungus'
                : "--fungus --species=${params.augustus_species} --useexisting --skipAllTraining"
        }
        publishDir = [
            path: { "${params.outdir}/species/${meta.id}/candidates/genes/braker3" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.tokenize('/')[-1] },
        ]
    }

    withName: 'AUGUSTUS' {
        publishDir = [
            path: { "${params.outdir}/species/${meta.id}/candidates/genes/augustus" },
            mode: params.publish_dir_mode,
        ]
    }

    withName: 'PLEXEMBLER_GENES' {
        publishDir = [
            path: { "${params.outdir}/species/${meta.id}/annotation" },
            mode: params.publish_dir_mode,
        ]
    }

    withName: 'BUSCO_PROTEINS' {
        ext.args   = { params.busco_db ? '--offline' : '' }
        ext.prefix = { "${meta.id}.proteins" }
        publishDir = [
            path: { "${params.outdir}/species/${meta.id}/annotation/qc/busco" },
            mode: params.publish_dir_mode,
            pattern: '{short_summary.*,*-busco.batch_summary.txt,*-busco.log}',
        ]
    }

    withName: 'TRNASCANSE' {
        publishDir = [
            path: { "${params.outdir}/species/${meta.id}/annotation/ncrna/trnascan" },
            mode: params.publish_dir_mode,
        ]
    }

    withName: 'BARRNAP' {
        publishDir = [
            path: { "${params.outdir}/species/${meta.id}/annotation/ncrna/barrnap" },
            mode: params.publish_dir_mode,
        ]
    }

    //
    // Each species' expression and tracks (EXPRESSION)
    //
    withName: 'SUBREAD_FEATURECOUNTS' {
        // Pairs on exons, by gene; strandedness from meta.strandedness.
        ext.args   = '-t exon -g gene_id --countReadPairs'
        publishDir = [
            path: { "${params.outdir}/species/${meta.id}/expression/featurecounts" },
            mode: params.publish_dir_mode,
        ]
    }

    withName: 'PLEXEMBLER_EXPRESSION' {
        publishDir = [
            path: { "${params.outdir}/species/${meta.id}/expression" },
            mode: params.publish_dir_mode,
        ]
    }

    withName: 'BAMCOVERAGE_FORWARD|BAMCOVERAGE_REVERSE' {
        // The genes' strand: deepTools reads it from a dUTP (reverse) library;
        // a forward library swaps the two.
        ext.args   = {
            def strand = task.process.endsWith('FORWARD') ? 'forward' : 'reverse'
            if (params.rnaseq_strandedness == 'forward') {
                strand = strand == 'forward' ? 'reverse' : 'forward'
            }
            def filter = params.rnaseq_strandedness == 'unstranded' ? '' : "--filterRNAstrand ${strand}"
            "${filter} --normalizeUsing CPM --binSize 10"
        }
        ext.prefix = { "${meta.id}.${meta.library}.${task.process.endsWith('FORWARD') ? 'forward' : 'reverse'}" }
        publishDir = [
            path: { "${params.outdir}/species/${meta.id}/tracks" },
            mode: params.publish_dir_mode,
        ]
    }

    withName: 'MINIMAP2_ONT_GENOME' {
        ext.args   = '-x map-ont'
        ext.prefix = { "${meta.id}.ont" }
        publishDir = [ enabled: false ]
    }

    withName: 'BAMCOVERAGE_ONT' {
        // The nanopore reads' depth, as it is.
        ext.args   = '--normalizeUsing None --binSize 50'
        ext.prefix = { "${meta.id}.ont" }
        publishDir = [
            path: { "${params.outdir}/species/${meta.id}/tracks" },
            mode: params.publish_dir_mode,
        ]
    }

    //
    // Each species' report, and chromosomix's store of the results
    //
    withName: 'PLEXEMBLER_REPORT' {
        publishDir = [
            path: { "${params.outdir}/species/${meta.id}" },
            mode: params.publish_dir_mode,
        ]
    }

    withName: 'PLEXEMBLER_BROWSER' {
        ext.args   = { params.browser_base ? "--base ${params.browser_base}" : '' }
        publishDir = [
            path: { "${params.outdir}" },
            mode: params.publish_dir_mode,
            pattern: 'chromosomix.store.json',
        ]
    }

    withName: 'MULTIQC' {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode
        ]
    }

}
