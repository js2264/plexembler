/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for the benchmark pool's small set
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Three yeasts, two of a genus, and their pool, simulated from their
    references by benchmarks/make_benchmark_data.py, or downloaded from the
    release benchmark-data-v<N> (benchmarks/README.md). The milestones' "Done
    when" are checked on it, by benchmarks/evaluate.py.

    Use as follows:
        nextflow run js2264/plexembler -profile benchmark,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

params {
    config_profile_name        = 'Benchmark profile'
    config_profile_description = 'The benchmark pool\'s small set: S. cerevisiae, S. paradoxus and N. glabratus, simulated'

    input     = "${projectDir}/benchmarks/data/small/species.csv"
    libraries = "${projectDir}/benchmarks/data/small/libraries.csv"

    // The split reads, whose names say their true species (evaluate.py).
    save_split_reads = true
}

// The benchmarks' workflow runs on GitHub's runner for a public repository:
// 4 CPUs and 16 GB, room left for Docker and Nextflow itself; 12 GB also fits
// a 16 GB laptop, whose free memory Nextflow counts. A task asking for more
// (process_high's 12 CPUs) is refused rather than queued.
process {
    resourceLimits = [
        cpus: 4,
        memory: '12.GB',
        time: '6.h'
    ]
}
