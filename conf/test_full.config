/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running full-size tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    A pool made in silico from public data of yeasts with telomere-to-telomere
    references, so that every result can be checked against the truth. The
    dataset comes with milestone 1 of docs/plan.md, as a versioned release
    asset (test-data-v1); until then this profile has no input.

    Use as follows:
        nextflow run js2264/plexembler -profile test_full,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

params {
    config_profile_name        = 'Full test profile'
    config_profile_description = 'An in-silico pool of yeasts with known references (docs/plan.md, milestone 1)'
}
