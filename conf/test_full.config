/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running full-size tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    A pool made in silico from public data of yeasts with telomere-to-telomere
    references, so that every result can be checked against the truth. Its
    dataset is to come (docs/plan.md, T2: `test_full`, five to ten yeasts, on
    Zenodo); until then this profile has no input. The benchmark pool's
    profiles (benchmark_easy, benchmark_medium, benchmark_hard) are the runs on
    yeasts with known references meanwhile (benchmarks/README.md).

    Use as follows:
        nextflow run js2264/plexembler -profile test_full,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

params {
    config_profile_name        = 'Full test profile'
    config_profile_description = 'An in-silico pool of yeasts with known references (docs/plan.md, T2), to come'
}
