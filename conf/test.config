/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Two species of a few dozen kilobases, in one pool with a Hi-C, a WGS and an
    RNA-seq library: the pipeline's plumbing, in a minute. The data sit in
    tests/data/, beside the script that makes them (make_test_data.py).

    Use as follows:
        nextflow run js2264/plexembler -profile test,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

// GitHub's runners for this repository: 2 CPUs and 7 GB.
process {
    resourceLimits = [
        cpus: 2,
        memory: '7.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Two species and a pool of libraries, a few kilobases each: the plumbing'

    // The samplesheets' relative paths are read from their folder.
    input     = "${projectDir}/tests/data/species.csv"
    libraries = "${projectDir}/tests/data/libraries.csv"

    // BUSCO's smallest lineage (29 MB): the test species' genes are random.
    busco_lineage = 'eukaryota_odb12'
}
