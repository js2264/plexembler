/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for the benchmark pool's easy set
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    The benchmark profile (benchmark.config), on its easy set: a Ty1 element per chromosome, long accurate reads, deep Hi-C
    (benchmarks/README.md).

    Use as follows:
        nextflow run js2264/plexembler -profile benchmark_easy,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

includeConfig 'benchmark.config'

params {
    config_profile_name        = 'Benchmark profile, easy set'
    config_profile_description = 'The benchmark pool\'s easy set: S. cerevisiae, S. paradoxus and N. glabratus, simulated'

    input     = "${projectDir}/benchmarks/data/easy/species.csv"
    libraries = "${projectDir}/benchmarks/data/easy/libraries.csv"
}
