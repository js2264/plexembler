/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for the benchmark pool's hard set
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    The benchmark profile (benchmark.config), on its hard set: Ty1 clusters, Y' arrays and an rDNA array, short reads, sparse Hi-C
    (benchmarks/README.md).

    Use as follows:
        nextflow run js2264/plexembler -profile benchmark_hard,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

includeConfig 'benchmark.config'

params {
    config_profile_name        = 'Benchmark profile, hard set'
    config_profile_description = 'The benchmark pool\'s hard set: S. cerevisiae, S. paradoxus and N. glabratus, simulated'

    input     = "${projectDir}/benchmarks/data/hard/species.csv"
    libraries = "${projectDir}/benchmarks/data/hard/libraries.csv"
}
