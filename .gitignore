# CONVENTIONS.md § 17: the standard Python list, then the repository's own
# outputs. Never uv.lock or .python-version, which are committed.

# Python
__pycache__/
*.py[cod]
*.so
*.egg-info/
.eggs/
build/
dist/
.venv/

# Tests and coverage
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.ruff_cache/
.mypy_cache/

# The documentation site, as zensical builds it, and its cache, which a
# .gitignore of its own hides from git but not from the sdist's builder
/site/
/.cache/

# Editors and systems
.vscode/
.idea/
.DS_Store

# Instructions for coding agents are AGENTS.md, and nothing else
# (CONVENTIONS.md § 21): a personal CLAUDE.md holding `@AGENTS.md` stays out.
CLAUDE.md
CLAUDE.local.md

# The repository's own outputs

# Nextflow: its caches, work directories and logs; the pipeline's outputs
# (--outdir); nf-test's runs. Anchored, so that tests/data/ stays tracked.
.nextflow*
/work/
/results/
/testing/
/testing*/
/null/
.lineage/
.nf-test/
.nf-test.log

# The benchmark data: generated or downloaded (benchmarks/README.md), never committed.
/benchmarks/data/

# pixi: pixi.toml defines the conda package alone, whose builds go to .pixi/
# and to conda-dist/ (pipeline.yml); the environments are uv's, so pixi's lock,
# were a command write one, stays out.
/.pixi/
/pixi.lock
/conda-dist/
# nf-test's wrappers of a workflow test
/.nf-test-*.nf
