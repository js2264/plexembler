nextflow_process {

    name "Test process PLEXEMBLER_RENAME"
    script "../main.nf"
    process "PLEXEMBLER_RENAME"

    tag "modules"
    tag "modules_local"
    tag "plexembler"
    tag "plexembler/rename"

    test("a species' contigs") {

        when {
            process {
                """
                input[0] = [
                    [ id: 'sp1' ],
                    file('${moduleDir}/../../../../tests/data/truth/sp1.fa', checkIfExists: true),
                    [],
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert path(process.out.fasta[0][1]).readLines().findAll { line -> line.startsWith('>') } == ['>sp1_chr1', '>sp1_chr2'] },
                { assert path(process.out.names[0][1]).readLines()[1] == 'sp1_chr1\tchr1\t24000\t24000\t1\tNA' },
                { assert process.out.versions_plexembler[0][1] == 'plexembler' },
            )
        }
    }

    test("a circle written twice, and Flye's table of contigs") {

        when {
            process {
                """
                // sp1's first chromosome twice over, as Flye wrote the
                // benchmark's doubled mitochondrion, and its second once,
                // linear.
                def records = file('${moduleDir}/../../../../tests/data/truth/sp1.fa', checkIfExists: true)
                    .text.split('>').findAll { record -> record }
                    .collect { record -> record.readLines().drop(1).join('') }
                def contigs = file("\${launchDir}/assembly.fasta")
                contigs.text = ['>contig_1', records[0] * 2, '>contig_2', records[1]].join('\\n') + '\\n'
                def info = file("\${launchDir}/assembly_info.txt")
                info.text = [
                    ['#seq_name', 'length', 'cov.', 'circ.', 'repeat', 'mult.', 'alt_group', 'graph_path'],
                    ['contig_1', 48000, 90, 'Y', 'Y', 2, '*', '1'],
                    ['contig_2', 16000, 40, 'N', 'N', 1, '*', '2'],
                ].collect { row -> row.join('\\t') }.join('\\n') + '\\n'
                input[0] = [ [ id: 'sp1' ], contigs, info ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert path(process.out.names[0][1]).readLines()[1] == 'sp1_contig_1\tcontig_1\t24000\t48000\t2\tyes' },
                { assert path(process.out.names[0][1]).readLines()[2] == 'sp1_contig_2\tcontig_2\t16000\t16000\t1\tno' },
                { assert path(process.out.log[0][1]).text.contains('sp1_contig_1: 2 copies of a 24000-bp unit') },
            )
        }
    }

    test("a species' contigs - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id: 'sp1' ],
                    file('${moduleDir}/../../../../tests/data/truth/sp1.fa', checkIfExists: true),
                    [],
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.fasta.size() == 1 },
                { assert process.out.names.size() == 1 },
            )
        }
    }
}
