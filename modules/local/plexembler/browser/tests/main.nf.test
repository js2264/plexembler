nextflow_process {

    name "Test process PLEXEMBLER_BROWSER"
    script "../main.nf"
    process "PLEXEMBLER_BROWSER"

    tag "modules"
    tag "modules_local"
    tag "plexembler"
    tag "plexembler/browser"

    test("two species' files") {

        when {
            process {
                """
                input[0] = ['sp1=pool', 'sp2=pool']
                input[1] = ['sp1=species/sp1/genome/sp1.fa.gz', 'sp1=species/sp1/hic/sp1.mcool', 'sp2=species/sp2/genome/sp2.fa.gz']
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert path(process.out.store[0]).json.entries.size() == 3 },
            )
        }
    }

    test("two species' files - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = ['sp1=pool']
                input[1] = ['sp1=species/sp1/genome/sp1.fa.gz']
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.store.size() == 1 },
            )
        }
    }
}
