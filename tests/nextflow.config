/*
========================================================================================
    Nextflow config file for running nf-test tests
========================================================================================
    The tests run on the data in tests/data/ (conf/test.config); nf-core's
    modules' own tests, which read nf-core/test-datasets, are not run here
    (nf-test.config ignores them).
*/

// Fixes S3 access issues on self-hosted runners
aws.client.anonymous = true
